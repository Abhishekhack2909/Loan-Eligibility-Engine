# Copy to .env for local-only development. Every value here is a placeholder.
# Do not commit .env or replace placeholders with real credentials.

APP_NAME=loan-eligibility-engine

# Values consumed by the checked-in local docker-compose stack.
POSTGRES_PASSWORD=loan_engine_local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=loan-uploads
EVENT_QUEUE_NAME=loan-eligibility-events
AWS_DEFAULT_REGION=us-east-1

# MinIO/S3-compatible storage used by a host-run upload API. Compose services
# override this with the internal minio:9000 endpoint and matching credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
PRESIGNED_URL_EXPIRY_SECONDS=900

# Host-run PostgreSQL; Compose services use the same password with postgres:5432.
DATABASE_DSN=postgresql://loan_engine:loan_engine_local@localhost:15432/loan_engine

# The worker runs inside Compose, so this must use the n8n service alias.
N8N_COMPLETION_WEBHOOK_URL=http://n8n:5678/webhook/loan-ingestion-completed
N8N_WEBHOOK_URL=http://n8n:5678/webhook/loan-ingestion-completed
N8N_WEBHOOK_SECRET=local-n8n-webhook-secret
N8N_WEBHOOK_TIMEOUT_SECONDS=10

# Keep ingestion bounded and deterministic.
INGESTION_BATCH_SIZE=500

# Local event wiring: MinIO webhook -> event-router -> LocalStack SQS.
EVENT_ROUTER_URL=http://localhost:8091
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/loan-eligibility-events

# n8n and local email service placeholders.
N8N_ENCRYPTION_KEY=replace-with-a-local-n8n-encryption-key
N8N_HOST=n8n
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
MAILPIT_API_URL=http://localhost:8025/api/v1/send
MAIL_DELIVERY_MODE=mailpit
DEMO_RECIPIENTS=complexhat735+one@gmail.com,complexhat735+two@gmail.com
DEMO_NOTIFICATION_TOKEN=local-demo-notification-token
AWS_SES_ENABLED=false
AWS_SES_CREDENTIAL_NAME=AWS SES (configure in n8n)
AWS_SES_FROM=
N8N_POSTGRES_CREDENTIAL_NAME=Postgres local (configure in n8n)
WORKFLOW_C_ID=loan-eligibility-email-delivery

# Workflow A public-page and LLM branches.
PUBLIC_PAGE_MODE=fixture
LOAN_SOURCE_MODE=fixture
PUBLIC_PAGE_TIMEOUT_SECONDS=15
LLM_MODE=stub
LLM_STUB_URL=http://localhost:8090
LLM_API_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=local-model
